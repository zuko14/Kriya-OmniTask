# ==============================================================================
# KRIYA AI — Autonomous Operations Runtime & Omnitask Platform
# Production Environment Configuration Reference (.env.example)
# ==============================================================================
# Copy this file to .env and populate with your environment credentials.
# In production (APP_MODE=production), all critical variables are strictly validated.

# ==============================================================================
# 1. CORE SERVER & RUNTIME MODE
# ==============================================================================
NODE_ENV=production
# Runtime mode: production | staging | sandbox | test
# Sandbox and test allow in-memory sqlite and simulated models.
# Staging and production enforce PostgreSQL, real provider keys, and non-default secrets.
APP_MODE=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
PRETTY_LOGS=false
API_PREFIX=/api/v1

# ==============================================================================
# 2. PRIMARY PERSISTENCE & DATABASE
# ==============================================================================
# Drivers: 'postgres' (required for production) | 'sqlite' (sandbox/test only)
DB_DRIVER=postgres
DATABASE_URL=postgresql://kriya_admin:your_secure_db_password@localhost:5432/kriya_production
PGSSLMODE=prefer
DB_POOL_MIN=4
DB_POOL_MAX=25
DB_STATEMENT_TIMEOUT_MS=10000

# ==============================================================================
# 3. INDIA DATA RESIDENCY & SOVEREIGN HOSTING (DPDP ACT 2023)
# ==============================================================================
# Sovereign hosting regions: ap-south-1 (Mumbai Primary), ap-south-2 (Hyderabad DR)
HOSTING_REGION=ap-south-1
SECONDARY_HOSTING_REGION=ap-south-2
ENFORCE_SOVEREIGN_BOUNDARY=true
ALLOW_CROSS_BORDER_TRANSFER=false

# ==============================================================================
# 4. SECURITY, CRYPTOGRAPHY & SECRETS (Mandatory Min 32 Characters)
# ==============================================================================
# Generate secure random strings: openssl rand -base64 32
JWT_SECRET=kriya_production_super_secure_jwt_secret_32_chars_min_length
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
ENCRYPTION_KEY=kriya_production_encryption_key_32_bytes_length_required
SESSION_SECRET=kriya_production_session_secret_32_bytes_length_key
COOKIE_SECRET=kriya_production_cookie_secret_32_bytes_length_key

# ==============================================================================
# 5. DISTRIBUTED QUEUE & CACHE
# ==============================================================================
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_redis_password

# ==============================================================================
# 6. AI MODEL PROVIDERS (Consolidated Model Gateway)
# ==============================================================================
# OpenRouter (Primary Gateway for DeepSeek, Claude, Llama 3, GPT-4o with Cost Routing)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (Fallback Provider)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
# OPENAI_ORG_ID=org-your_org_id

# Anthropic Claude (Fallback Provider)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Google Gemini / Vertex AI
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Groq High-Speed Inference
GROQ_API_KEY=gsk_your_groq_api_key_here

# DeepSeek Native API
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# ==============================================================================
# 7. KNOWLEDGE RETRIEVAL & VECTOR EMBEDDINGS
# ==============================================================================
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ==============================================================================
# 8. OMNICHANNEL CHANNELS (Meta WhatsApp Cloud API)
# ==============================================================================
WHATSAPP_ACCESS_TOKEN=EAAG_your_whatsapp_system_user_token
WHATSAPP_PHONE_NUMBER_ID=109283746592019
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_APP_SECRET=kriya_whatsapp_app_secret_production_2026
WHATSAPP_WEBHOOK_VERIFY_TOKEN=kriya_whatsapp_verify_token_secure_2026

# ==============================================================================
# 9. PAYMENTS & GATEWAY INTEGRATIONS
# ==============================================================================
# Razorpay (India Primary)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe (International)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ==============================================================================
# 10. INDIA DPDP 2023 COMPLIANCE & GOVERNANCE
# ==============================================================================
DPDP_RETENTION_DAYS=730
DPDP_GRIEVANCE_OFFICER_NAME="Kriya DPDP Grievance Officer"
DPDP_GRIEVANCE_OFFICER_EMAIL="dpo@kriya.ai"
DPDP_BREACH_NOTIFICATION_EMAIL="dpbi-intimations@kriya.ai"
DPDP_SAR_SLA_HOURS=72

# ==============================================================================
# 11. SRE, OBSERVABILITY & MULTI-WINDOW SLO ALERTING
# ==============================================================================
PROMETHEUS_METRICS_ENABLED=true
METRICS_PATH=/metrics
SLO_BURN_RATE_1H_THRESHOLD=14.4
SLO_BURN_RATE_6H_THRESHOLD=6.0
SLO_BURN_RATE_24H_THRESHOLD=3.0

# ==============================================================================
# 12. CANARY DEPLOYMENT & ROLLBACK ENGINE
# ==============================================================================
CANARY_ERROR_RATE_TRIPWIRE_PCT=1.0
CANARY_P99_LATENCY_TRIPWIRE_MS=1500
INSTANT_ROLLBACK_ENABLED=true

# ==============================================================================
# 13. LIVE TEST KEYS (Git-Ignored / Developer Smoke Testing)
# ==============================================================================
# Set for running live model evaluation smoke tests:
# KRIYA_LIVE_TEST_OPENROUTER_KEY=sk-or-v1-...
