# ==============================================================================
# XYLARC AI — Production Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and populate with your production credentials.
# All variables are validated strictly against Zod schemas on startup.

# ==============================================================================
# 1. CORE SERVER & RUNTIME
# ==============================================================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
PRETTY_LOGS=true
API_PREFIX=/api/v1

# ==============================================================================
# 2. PRIMARY DATABASE & PERSISTENCE
# ==============================================================================
# Drivers supported: 'sqlite' | 'postgres'
DB_DRIVER=sqlite
DATABASE_URL=:memory:

# For PostgreSQL / Neon / Cloud SQL:
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/xylarc_db
# PGSSLMODE=require
# DB_POOL_MIN=2
# DB_POOL_MAX=20

# ==============================================================================
# 3. SUPABASE INTEGRATION (Optional / Managed Backend)
# ==============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_DB_PASSWORD=your_supabase_db_password

# ==============================================================================
# 4. DISTRIBUTED QUEUE & CACHE (Redis)
# ==============================================================================
# REDIS_URL=redis://default:your_redis_password@localhost:6379
# REDIS_PASSWORD=your_redis_password

# ==============================================================================
# 5. SECURITY, AUTHENTICATION & CRYPTOGRAPHY (Mandatory Min 32 Characters)
# ==============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=xylarc_default_secure_jwt_secret_must_be_32_chars_long
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
ENCRYPTION_KEY=xylarc_default_encryption_key_32_bytes_min_length
SESSION_SECRET=session_encryption_secret_key_32_bytes
COOKIE_SECRET=cookie_signing_secret_key_32_bytes

# ==============================================================================
# 6. AI MODEL PROVIDERS & INFERENCE (Multi-Provider Dynamic Fallback)
# ==============================================================================
# OpenRouter (Unified Gateway for DeepSeek, Claude, Llama 3, GPT-4o, etc. with Cost Routing)
OPENROUTER_API_KEY=sk-or-v1-...your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini / Vertex AI
GEMINI_API_KEY=AIzaSy...your_gemini_api_key
GOOGLE_VERTEX_PROJECT_ID=your-gcp-project-id
GOOGLE_VERTEX_LOCATION=us-central1

# OpenAI
OPENAI_API_KEY=sk-proj-...your_openai_api_key
OPENAI_ORG_ID=org-...

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...your_anthropic_api_key

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key

# Groq High-Speed Inference
GROQ_API_KEY=gsk_...your_groq_api_key

# Hugging Face Inference Endpoints
HUGGINGFACE_API_KEY=hf_...your_huggingface_api_key

# Local Ollama Inference (Self-Hosted)
# OLLAMA_BASE_URL=http://localhost:11434

# ==============================================================================
# 7. KNOWLEDGE FABRIC & VECTOR EMBEDDINGS
# ==============================================================================
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# Vector Databases (Optional)
# PINECONE_API_KEY=your_pinecone_api_key
# PINECONE_INDEX=xylarc-knowledge-index
# QDRANT_URL=https://your-cluster.qdrant.tech
# QDRANT_API_KEY=your_qdrant_api_key

# ==============================================================================
# 8. PAYMENTS & MONETIZATION (Stripe)
# ==============================================================================
STRIPE_SECRET_KEY=sk_test_...your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_...your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_...your_stripe_webhook_secret

# ==============================================================================
# 9. OMNICHANNEL COMMUNICATION GATEWAYS
# ==============================================================================
# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=EAAG...your_whatsapp_system_user_token
WHATSAPP_PHONE_NUMBER_ID=109283746592019
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_APP_SECRET=xylarc_whatsapp_app_secret_test_2026
WHATSAPP_WEBHOOK_VERIFY_TOKEN=xylarc_whatsapp_verify_token_secure_2026

# Twilio (Voice Calls & SMS Outbound)
TWILIO_ACCOUNT_SID=AC...your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# Outbound Email (Resend or SMTP)
RESEND_API_KEY=re_...your_resend_api_key
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=notifications@yourdomain.com

# ==============================================================================
# 10. ENTERPRISE GOVERNANCE & AUTONOMY GUARDRAILS
# ==============================================================================
TENANT_ISOLATION_STRICT=true
MAX_AGENT_DELEGATION_DEPTH=5
DEFAULT_AUTONOMY_LEVEL=1
ENABLE_AUDIT_LOGGING=true

# ==============================================================================
# 11. SRE, OBSERVABILITY & METRICS
# ==============================================================================
# SENTRY_DSN=https://your_key@o0.ingest.sentry.io/0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_METRICS_ENABLED=true
