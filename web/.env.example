VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe Frontend Client Key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...your_stripe_publishable_key

# Environment Name
VITE_APP_ENV=development
